@model MetallurgyApp.Client.Models.ProductionAreaDto
@{ ViewData["Title"] = "Участок: " + Model.Name; }

<h2>@Model.Name</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Workshop)</dt>
    <dd class="col-sm-9">@Model.Workshop</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Head)</dt>
    <dd class="col-sm-9">@Model.Head</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CommissionedAt)</dt>
    <dd class="col-sm-9">@Model.CommissionedAt.ToString("dd.MM.yyyy")</dd>
</dl>

<h4>Оборудование на участке (@Model.Equipments.Count)</h4>

@if (Model.Equipments.Any())
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Название</th>
                <th>Модель</th>
                <th>Производитель</th>
                <th>Год</th>
                <th>Состояние</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Equipments)
        {
            <tr>
                <td>@e.Name</td>
                <td>@e.Model</td>
                <td>@e.Manufacturer</td>
                <td>@e.ManufactureYear</td>
                <td>@Html.DisplayFor(_ => e.State)</td>
                <td class="text-end">
                    <a asp-controller="Equipments" asp-action="Details"
                       asp-route-id="@e.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-controller="Equipments" asp-action="Edit"
                       asp-route-id="@e.Id" class="btn btn-sm btn-warning">Изменить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">На участке нет зарегистрированного оборудования.</p>
}

<div class="mt-3">
    <a asp-controller="Equipments" asp-action="Create"
       class="btn btn-success">+ Добавить оборудование</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Изменить участок</a>
    <a asp-action="Index" class="btn btn-secondary">К списку</a>
</div>