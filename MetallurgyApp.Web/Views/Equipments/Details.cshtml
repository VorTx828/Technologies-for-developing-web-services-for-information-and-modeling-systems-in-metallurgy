@model MetallurgyApp.Client.Models.EquipmentDto
@{ ViewData["Title"] = "Оборудование: " + Model.Name; }

<h2>@Model.Name</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Model)</dt>
    <dd class="col-sm-9">@Model.Model</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Manufacturer)</dt>
    <dd class="col-sm-9">@Model.Manufacturer</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ManufactureYear)</dt>
    <dd class="col-sm-9">@Model.ManufactureYear</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.State)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.State)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ProductionArea)</dt>
    <dd class="col-sm-9">
        @if (Model.ProductionArea is not null)
        {
            <a asp-controller="ProductionAreas" asp-action="Details"
               asp-route-id="@Model.ProductionArea.Id">
                @Model.ProductionArea.Name
            </a>
        }
        else
        {
            <span class="text-muted">— не указан —</span>
        }
    </dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Изменить</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Удалить</a>
    <a asp-action="Index" class="btn btn-secondary">К списку</a>
</div>