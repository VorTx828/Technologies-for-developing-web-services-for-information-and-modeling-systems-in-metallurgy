@model MetallurgyApp.Client.Models.RegisterDto
@{ ViewData["Title"] = "Регистрация"; }

<h2>Регистрация</h2>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="UserName" class="form-label"></label>
        <input asp-for="UserName" class="form-control" autocomplete="username" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role"
                asp-items="Html.GetEnumSelectList<MetallurgyApp.Client.Models.UserRole>()"
                class="form-select"></select>
        <div class="form-text">
            Первый зарегистрированный пользователь автоматически становится Admin.
        </div>
    </div>
    <button type="submit" class="btn btn-success">Зарегистрироваться</button>
    <a asp-action="Login" class="btn btn-link">У меня есть аккаунт</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }