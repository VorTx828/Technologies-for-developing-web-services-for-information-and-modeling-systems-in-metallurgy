@{ ViewData["Title"] = "Чат"; }

<h2>Чат</h2>

<div id="chat-box"
     style="height:400px; overflow-y:auto; border:1px solid #ccc; padding:8px; margin-bottom:8px;"></div>

<div class="input-group">
    <input id="chat-input" class="form-control" placeholder="Сообщение..." />
    <button id="chat-send" class="btn btn-primary">Отправить</button>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const accessToken = '@Html.Raw(ViewBag.AccessToken)';
        const hubUrl = '@ViewBag.HubUrl';
        const isAdmin = @(ViewBag.IsAdmin ? "true" : "false");   // ← роль

        const box = document.getElementById('chat-box');
        const input = document.getElementById('chat-input');
        const sendBtn = document.getElementById('chat-send');
        sendBtn.disabled = true;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(hubUrl, {
                accessTokenFactory: () => accessToken,
                withCredentials: true
            })
            .withAutomaticReconnect()
            .build();

        function appendMessage(id, userName, text, sentAt) {
            const div = document.createElement('div');
            div.dataset.id = id;
            div.className = 'chat-message mb-2';
            div.innerHTML = `
                <b>${userName}</b>
                <small class="text-muted">${new Date(sentAt).toLocaleTimeString()}</small>
                ${isAdmin ? `<button class="btn btn-sm btn-danger ms-2 delete-btn" data-id="${id}">Удалить</button>` : ''}
                <br>${text}
            `;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        connection.on('ReceiveMessage', (id, userName, text, sentAt) => {
            appendMessage(id, userName, text, sentAt);
        });

        // === Обработчик удаления ===
        connection.on('MessageDeleted', (id) => {
            const el = box.querySelector(`[data-id="${id}"]`);
            if (el) el.remove();
        });

        // === Клик по «Удалить» (делегирование) ===
        box.addEventListener('click', async (e) => {
            if (!e.target.classList.contains('delete-btn')) return;
            const id = e.target.dataset.id;   // ← без parseInt
            if (!confirm('Удалить это сообщение?')) return;
            try {
                await connection.invoke('DeleteMessage', id);   // строка GUID
            } catch (err) {
                alert('Ошибка: ' + err.message);
            }
        });

        async function start() {
            try {
                await connection.start();
                const history = await connection.invoke('GetHistory', 50);
                history.forEach(m => appendMessage(m.id, m.userName, m.text, m.sentAt));
                sendBtn.disabled = false;
            } catch (err) {
                console.error('SignalR:', err);
                setTimeout(start, 3000);
            }
        }

        sendBtn.onclick = async () => {
            const text = input.value.trim();
            if (!text) return;
            await connection.invoke('SendMessage', text);
            input.value = '';
        };
        input.addEventListener('keydown', e => { if (e.key === 'Enter') sendBtn.click(); });

        start();
    </script>
}